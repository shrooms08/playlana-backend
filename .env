# Authority keypair that signs every program instruction.
# Either:
#   - base58 string (e.g. exported via `solana-keygen pubkey --keypair authority.json` then convert)
#   - JSON array of 64 numbers (the format `solana-keygen new -o authority.json` writes)
# NEVER commit the real value.
AUTHORITY_SECRET_KEY=[116,247,159,120,98,172,19,193,102,206,119,112,11,47,38,148,22,123,219,122,254,127,182,77,180,23,50,157,251,31,103,135,116,86,234,37,170,9,211,217,145,64,15,179,155,54,10,217,99,236,209,139,126,90,185,209,119,120,234,62,232,2,164,177]

# Helius RPC endpoint (devnet for hackathon). If unset, falls back to public devnet.
# Example: https://devnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=24723246-7b95-4e7f-a936-467a88d99c0b

# On-chain program ID. Cross-checked against the IDL's address field.
