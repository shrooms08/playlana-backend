# Authority keypair that signs every program instruction.
# Either:
#   - base58 string (e.g. exported via `solana-keygen pubkey --keypair authority.json` then convert)
#   - JSON array of 64 numbers (the format `solana-keygen new -o authority.json` writes)
# NEVER commit the real value.
AUTHORITY_SECRET_KEY=

# Helius RPC endpoint (devnet for hackathon). If unset, falls back to public devnet.
# Example: https://devnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_RPC_URL=

# On-chain program ID. Cross-checked against the IDL's address field.
PROGRAM_ID=EQ2tfEf3XJbiCX7bsubCJUJLPBmkhWFiRXq7pjJQ59WV

# GameShift API key for wallet provisioning (used by /api/register-wallet).
# Get one at https://gameshift.dev/. Treat as a secret.
GAMESHIFT_API_KEY=

# SOAR (populated by scripts/init-soar.ts after first run)
SOAR_GAME_PUBKEY=
SOAR_LEADERBOARD_PUBKEY=

# 32-byte secret used to deterministically derive a per-player SOAR keypair
# from the player's PlayLana (GameShift) wallet. Encoded as base58 or hex (64
# hex chars). SOAR's program requires the user to sign their own Player
# account creation, so we mint backend-controlled keypairs per player. Treat
# as a secret — leaking it lets anyone forge SOAR scores under any player's
# derived identity. The init script will print a generated value if unset.
SOAR_PLAYER_SEED=
